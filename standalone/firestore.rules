rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada pessoa só lê e escreve na sua própria pasta, e só a tua conta Google pode entrar.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.email == "O-TEU-EMAIL@gmail.com";
    }
  }
}
